{
  "name": "kinde-testkit",
  "version": "0.1.0",
  "description": "Test Kinde-authenticated apps offline: signed Kinde-shaped tokens, a local JWKS issuer, and reusable auth scenarios.",
  "license": "MIT",
  "author": "Shola Jegede <jegedeshola@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/kinde-testkit.git"
  },
  "keywords": ["kinde", "testing", "jwt", "jwks", "oidc", "vitest", "auth"],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "kinde-testkit": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
