{
  "name": "kinde-testkit",
  "version": "0.7.1",
  "description": "Test Kinde-authenticated apps offline: a local issuer with a real sign-in flow, Kinde-shaped tokens, reusable auth scenarios, and Vitest and Playwright helpers.",
  "license": "MIT",
  "author": "Shola Jegede <jegedeshola@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sholajegede/kinde-testkit.git"
  },
  "keywords": [
    "kinde",
    "testing",
    "jwt",
    "jwks",
    "oidc",
    "vitest",
    "auth",
    "playwright",
    "oauth",
    "jest",
    "cypress",
    "emulator"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "kinde-testkit": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      }
    },
    "./cypress": {
      "import": {
        "types": "./dist/cypress.d.ts",
        "default": "./dist/cypress.js"
      },
      "require": {
        "types": "./dist/cypress.d.cts",
        "default": "./dist/cypress.cjs"
      }
    },
    "./cypress/support": {
      "import": {
        "types": "./dist/cypress-support.d.ts",
        "default": "./dist/cypress-support.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:contract": "vitest run test/contract"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40",
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kinde/js-utils": "^0.32.2",
    "@kinde/jwt-validator": "^0.5.0",
    "@kinde/management-api-js": "^0.20.0",
    "@kinde/webhooks": "^1.3.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "jest": "^30.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
